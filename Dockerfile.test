###############################################
#  LESforMacOS Custom — テスト実行環境
#
#  使い方:
#    docker build -f Dockerfile.test -t les-test .
#    docker run --rm les-test
#
#  Lua テストのみ実行:
#    docker run --rm les-test busted extensions/les/tests/
#
#  luacheck 静的解析のみ:
#    docker run --rm les-test luacheck extensions/les/
#
#  シェルに入る:
#    docker run --rm -it les-test /bin/sh
###############################################

FROM debian:bookworm-slim@sha256:abd67ffcfa541b485a3dff59865ab629aa048a6c613e639d36e7456b0b229241

# -------------------------------------------
#  システムパッケージ
# -------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    lua5.4 \
    liblua5.4-dev \
    luarocks \
    gcc \
    libc6-dev \
    make \
    curl \
    ca-certificates \
    git \
    && rm -rf /var/lib/apt/lists/*

# -------------------------------------------
#  Lua テスト・静的解析ツール
# -------------------------------------------
# IMPORTANT: pin to Lua 5.4 — Debian's luarocks defaults to Lua 5.1,
# which cannot even parse production code using goto (Lua 5.2+)
RUN luarocks-5.4 install busted 2.3.0-1 \
    && luarocks-5.4 install luacheck 1.2.0-1

# -------------------------------------------
#  アプリケーションコード
# -------------------------------------------
WORKDIR /app

# Lua ソースとテスト
COPY .luacheckrc ./
COPY README.md ./README.md
COPY docs/ ./docs/
COPY extensions/_coresetup/_coresetup.lua ./extensions/_coresetup/_coresetup.lua
COPY extensions/les/ ./extensions/les/
COPY scripts/run-lua-tests.sh /usr/local/bin/run-lua-tests
RUN chmod 755 /usr/local/bin/run-lua-tests

# -------------------------------------------
#  デフォルト: 全テスト実行
# -------------------------------------------
CMD ["run-lua-tests"]
